
{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Multi-currency expense tracker with live exchange rates",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --collectCoverageFrom=src/utils.js --collectCoverageFrom=src/api.js --collectCoverageFrom=src/state.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "start": "npx serve ."
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}